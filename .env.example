# Not used by the current code path — kept as a reference for the two values the
# Pionex API needs. The CLI and lib/futures.mjs both read ~/.pionex/config.toml
# instead (see README.md). Delete this file if you never wire up dotenv.
#
# Key permissions must match what you actually intend to run:
#   research only  -> "Enable Reading" + "Bot Reading"
#   autonomous trading (this repo's mandate, see CLAUDE.md)
#                  -> also "Trading" / "Bot Trading"
# Never enable Transfer or Withdraw. IP-whitelist the key either way.
PIONEX_API_KEY=
PIONEX_API_SECRET=
